# ═══════════════════════════════════════════════════════════════════
# राहुल वॉयस असिस्टेंट — all controls (copy to .env and edit)
# Every var is optional; values below are the defaults.
# Shell env vars win over this file.
# ═══════════════════════════════════════════════════════════════════
GROQ_API_KEY=your_groq_key_here
# ---------- Voice / speaker ----------
# Reference audio clip for voice cloning (path relative to Voice_Cloning/)
VOICE_REF_AUDIO=my_voice.wav
# Exact transcript of that clip (used to build the voice-clone prompt)
VOICE_REF_TEXT=कोडिंग में बहुत मज़ा आता है, बट समटाइम्स बग्स आर सो अनोइंग यार।
# Where main.py saves its output
VOICE_OUTPUT=output.wav
# Demo text used by main.py when no CLI arg is given
VOICE_DEMO_TEXT=अरे वाह! आपने तो बहुत अच्छा सवाल पूछा।

# ---------- TTS model / quality ----------
# HF repo or local folder for the OmniVoice checkpoint
OMNIVOICE_MODEL=k2-fsa/OmniVoice
# Diffusion unmasking steps. T4 fp16: 4-6 is fluent realtime; 8 was the
# MPS-era setting. Keep FIRST at 2-4 so the reply starts instantly.
VOICE_NUM_STEP=6
# Max diffusion steps for the FIRST audio window (faster start;
# set = VOICE_NUM_STEP to disable)
VOICE_FIRST_STEP=4
# Allowed diffusion-step range (validated on every request)
VOICE_STEP_MIN=4
VOICE_STEP_MAX=64
# Sampling temperature for token selection (0 = greedy)
VOICE_TEMPERATURE=0.3
# Speaking speed used when a request doesn't send `speed`.
# T4 realtime: 1.15 stays lively and shortens every window's audio without
# changing gen time (GPU pulls further ahead of playback each frame).
VOICE_SPEED=1.15
# OmniVoice language id for Hindi token stats + duration estimate ("hi").
VOICE_TTS_LANGUAGE=hi
# Per-window edge trims (seconds). Upstream defaults are 0.1/0.1 — 200ms of
# dead air on EVERY streamed frame. 0.02 keeps seams clean.
VOICE_TTS_PAD_S=0.02
VOICE_TTS_FADE_S=0.02
# Sample rate for saved/streamed WAV (OmniVoice always generates 24 kHz)
VOICE_SAMPLE_RATE=24000
# Sentences synthesized together per audio window (1 = per sentence;
# 2-3 = fewer prosody restarts, more natural flow; smaller = faster frames)
VOICE_STREAM_WINDOW=2
# Max text chars per audio window / TTS frame (~90 ≈ 5s audio). Smaller =
# snappier first audio + shorter interrupt tail; bigger = smoother prosody.
# Never ship a non-final TTS window smaller than this (groups the LLM's short
# sentences into continuous frames instead of tiny 2-3 word audio chunks).
VOICE_MIN_WINDOW_CHARS=28
VOICE_WINDOW_CHARS=110
# Client audio frames buffered before playback. 1 lowers first-audio latency;
# use 2 if the GPU cannot keep up and playback underruns.
VOICE_JITTER_FRAMES=1
# Hard ceiling on sentences per chat reply (stops LLM rambling -> monologue)
VOICE_MAX_SENTENCES=6
# Greeting/small-talk replies stop after this many sentences
VOICE_GREETING_MAX=2
# Max utf-8 bytes per streaming sentence chunk (smaller =
VOICE_STREAM_MAX_CHARS=75
# Chars in the very first audio window (smaller = faster first audio)
VOICE_FIRST_WINDOW_CHARS=40   # T4: 30-45 covers a full opening clause; 16 cut words in half mid-word
# Pauses after punctuation (seconds). Individually: VOICE_PAUSE_COMMA / _SEMI /
# _FULL / _QUESTION / _EXCLAM / _DANDA. Scale multiplies all.
VOICE_PAUSE_SCALE=1.0
# Per-sentence pacing (delivery energy). Excited >1.0 speeds up, dramatic <1.0
# slows down; long sentences (over VOICE_LONG_CHARS) get VOICE_LONG_SPEED.
VOICE_EXCITED_SPEED=1.12
VOICE_DRAMATIC_SPEED=0.92
VOICE_LONG_SPEED=0.96
VOICE_LONG_CHARS=110
VOICE_SPEED_MIN=0.3
VOICE_SPEED_MAX=2.0

# ---------- LLM (chat) ----------
# Active provider per turn: groq | deepseek (the UI toggle overrides this per turn).
LLM_PROVIDER=groq
# DeepSeek (OpenAI-compatible). Set DEEPSEEK_MODEL to the exact model id
# DeepSeek gave you (e.g. deepseek-chat for V3, or your "flash" model id).
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_URL=https://api.deepseek.com/chat/completions
# Realtime voice needs thinking OFF (V4 thinks by default and voice waits).
# enabled = think first (slow, reasoning_content before content).
DEEPSEEK_THINKING=disabled
# Effort when thinking is enabled: low | high | max (empty = server default).
# DEEPSEEK_REASONING_EFFORT=
# Optional: diagram planner model for DeepSeek turns (defaults to DEEPSEEK_MODEL).
# DEEPSEEK_DIAGRAM_MODEL=
# OpenAI-compatible model name (Groq hosts OpenAI's gpt-oss-120b as
# "openai/gpt-oss-120b"; any OpenAI-compatible model works if MISTRAL_URL is
# pointed at it).
LLM_MODEL=openai/gpt-oss-120b
# Sampling temperature for chat replies
LLM_TEMPERATURE=0.7
# Max tokens per chat reply. gpt-oss models "think" before answering and
# reasoning tokens count against this — keep it generous (2000) or hard
# questions can come back with EMPTY content (silent no-reply).
LLM_MAX_TOKENS=550
# Reasoning effort for gpt-oss models on Groq: low | medium | high ("" = omit).
# "low" = fastest first audio; raise only if answers feel too shallow.
LLM_REASONING_EFFORT=low
# Extra attempts for TRANSIENT LLM failures (429 rate-limit, 5xx, network
# blips, empty content). 0 = try once. Retries only happen before the first
# sentence is spoken, so a retry can never interrupt a playing reply.
LLM_RETRIES=2
# ---------- Diagram planner (whiteboard) ----------
# Model for per-window diagram deltas. Blank/unset = reuse LLM_MODEL.
# (Groq's developer tier serves no faster tool-capable model than
# gpt-oss-20b, so leave this blank; the speed win comes from the settings
# below, not the model.)
# DIAGRAM_MODEL=
# Max tokens per diagram tool call (2000 = full-potential board: ~15-20
# elements with code/note/table extras; the planner retries once at +50% if
# Groq 400s on truncated JSON). Costs ~1 extra Groq call per teaching turn
# on the qwen planner model. No reasoning is ever sent on this path.
DIAGRAM_MAX_TOKENS=2000
# Board planning: window = speech-synced visual deltas (production default).
# turn = ONE richer but later board per reply (rollback / lower-quota mode).
DIAGRAM_PLAN_MODE=window
# Planner gate: auto = every teaching turn draws (paid tier, default).
# explicit = only "draw/diagram/दिखाओ" draws (dev 8k TPM, saves ~10 calls/turn).
DIAGRAM_GATE=auto
# Done-grace: seconds after audio finishes to keep forwarding trailing board
# deltas before closing the turn (slow planners). Prevents "board par dekho"
# with an empty board. 0 disables.
DIAGRAM_DONE_GRACE_S=6
# Planner model: qwen is ~5x faster than gpt-oss and lives in its own rate
# bucket — per-window planner calls 429'd gpt-oss-120b to death (33 skips,
# 0 boards). Needs the key-strip in normalize() (qwen pads tool keys).
DIAGRAM_MODEL=qwen/qwen3.8-27b
# ---------- OS Director (agent window control) ----------
# Per-turn sidecar that lets the tutor open/arrange apps and drive the
# browser via os_action messages (1 fast tool call/turn, never blocks voice).
# The tutor OWNS the desktop: the learner has no dock, no window buttons and no
# drag/resize/close, so every window move comes from here — including opening
# the code editor / browser on its own when a teaching turn needs them.
# 1 = on (default), 0 = tutor can only speak + draw (and the desktop freezes).
OS_DIRECTOR_EVENTS=1
# Groq API key (required; the canonical entry lives at the top of this file —
# legacy fallbacks also read: LLM_API_KEY, MISTRAL_API_KEY).
# GROQ_API_KEY=
# Base URL for an OpenAI-compatible chat endpoint (defaults to Groq)
MISTRAL_URL=https://api.groq.com/openai/v1/chat/completions
# httpx stream timeout for the LLM call (seconds)
VOICE_LLM_TIMEOUT=120.0
# Optional: path to a text file that replaces the whole system prompt (tune the
# persona/voice style without editing code). Leave blank for the built-in one.
VOICE_PROMPT_FILE=

# ---------- Web chat UI behaviour (read from /api/config at page load) ----------
# Diffusion steps the browser asks for chat replies (quality vs speed)
VOICE_CHAT_STEP=8
# Conversation history kept per turn (older messages dropped)
VOICE_MAX_HISTORY=8
# WebSocket reconnect delay after a drop (ms)
VOICE_WS_RECONNECT_MS=1500
# SpeechRecognition restart delay when Chrome ends it (ms)
VOICE_REC_RESTART_MS=400
# Voice-activity check interval (ms) — drives barge-in + auto-send
VOICE_VAD_TICK_MS=50
# Silence after you stop talking before the message auto-sends (ms).
# Below ~500ms Whisper hears your speech in 1-2s fragments, each firing a
# separate reply. 700-900ms feels natural; 500ms is the aggressive floor.
VOICE_AUTO_SEND_MS=750
# Client-side end-of-speech fallback; server Silero VAD normally closes sooner.
# Min non-space chars to treat recognized text as real words
VOICE_SEND_MIN_CHARS=2
# VAD energy gates:
VOICE_VAD_NOISE=0.005          # starting ambient noise floor
VOICE_VAD_THRESHOLD_MIN=0.014  # voice gate floor (RMS)
VOICE_VAD_GATE_MULT=3.4        # gate = noise * this (or the min above)
VOICE_VAD_SUSTAIN_MS=250       # sustained energy = real voice (arms barge/send)
VOICE_VAD_TEXT_MS=150          # …or words heard + this much energy confirm
VOICE_VAD_FAILSAFE_MS=900      # sustained-energy failsafe when recognition lags
VOICE_SPEAK_TAIL_MS=700        # ms after OUR speaker audio stops during which mic recognition is ignored (echo guard)
VOICE_VAD_REC_ACTIVE_MS=400    # recognizer "active" window during/after speech
VOICE_BARGE_IDLE_MS=900        # recognizer-idle safety-net auto-send delay

# ---------- Hardware ----------
# cpu | mps | cuda   (auto-detected if unset)
VOICE_API_DEVICE=
# fp16 | fp32  (fp16 = CUDA default; MPS/CPU default fp32 — fp16 MPS can crash on torch 2.14)
VOICE_API_DTYPE=

# ---------- Voice input: streaming ASR (/ws/asr) ----------
# The browser mic audio (already echo-cancelled by Chrome) is transcribed here,
# replacing the Web Speech API — how OpenAI/Gemini realtime avoid echo.
# Backend: auto | mlx | faster-whisper.
#   auto            — mlx-whisper on Apple Silicon (Neural Engine, ~10x faster
#                     than CPU) when installed; faster-whisper everywhere else
#                     (CUDA fp16 on Kaggle/NVIDIA, CPU int8 otherwise). This is
#                     the setting to keep for the Kaggle upload.
#   mlx             — Apple Silicon only (pip: mlx-whisper). Greedy decode.
#   faster-whisper  — CTranslate2: realtime on CUDA; CPU int8 elsewhere.
ASR_BACKEND=auto
# CTranslate2 CPU worker threads for faster-whisper. The library's default (4)
# can corrupt the glibc heap on some Linux hosts ("malloc(): unaligned tcache
# chunk detected" aborts the whole server after a couple of decodes). 2 is
# safe and still realtime; raise only if transcription feels slow.
ASR_CPU_THREADS=2
# Model size: tiny | base | small | medium | large-v3-turbo.
#   large-v3-turbo (default) — the accuracy/speed sweet spot for Hindi/Hinglish
#     on both CUDA (Kaggle) and mlx (M4). ~1.6 GB. Best quality you can run
#     realtime in this pipeline; use it in production.
#   small — smaller download (~460 MB), noticeably worse Hindi; only if the
#     large download or RAM is a problem.
#   tiny / base — mangle Hindi; English experiments only.
ASR_MODEL=large-v3-turbo
# Spoken language: "hi" (default) = Hindi/Hinglish — accurate AND faster.
# LEAVE EMPTY only for true multilingual mode: Whisper auto-detect handles
# English well but routinely mislabels SHORT Hindi clips (as es/ru/ur…).
ASR_LANG=hi
# cpu | cuda (auto-detected if unset) — faster-whisper backend only
ASR_DEVICE=
# int8 (CPU) | float16 (CUDA) | float32 — auto-chosen if unset (fw backend).
# If the server ever aborts with a malloc/heap error on CPU, use int8_float32
# here — the pure-int8 SIMD path is the usual culprit on some CPUs.
ASR_COMPUTE=
# Whisper partial (live caption) cadence: new audio seconds + min gap seconds
VOICE_ASR_PARTIAL_NEW_SECONDS=0.45
VOICE_ASR_PARTIAL_GAP_SECONDS=0.9
# faster-whisper only: beam width for the AUTHORITATIVE final transcript (what
# gets sent to the assistant). 5 = better Hinglish accuracy for ~1.5x one-pass
# cost once per utterance. mlx-whisper has no beam decoder (always greedy).
ASR_FINAL_BEAM=5
# ---------- Noise-immune turn-taking (server-side neural VAD) ----------
# auto = Silero neural VAD when installed (recommended), else browser energy VAD
ASR_VAD_MODE=auto
# Silero thresholds: p(voice) to OPEN a turn (high = noise-proof) and to STAY
VOICE_SILERO_ON=0.55
VOICE_SILERO_HOLD=0.35
VOICE_SILERO_ON_MS=150        # speech this long opens the turn
VOICE_SILERO_SILENCE_MS=500   # lower closes turns faster; raise if natural pauses split speech
VOICE_SERVER_PRE_ROLL_S=0.4   # server-side ring buffer kept before the open decision
VOICE_MIN_UTT_MS=300          # utterances shorter than this are discarded as blips

# Speculative turn trigger: the browser starts the LLM reply on a fast greedy
# transcript (1) — the accurate beam final then reconciles in the background.
# 0 disables (reply waits for the beam final; higher latency, simplest path).
VOICE_ASR_SPECULATIVE=1
# How long the client waits for the speculative/final transcript before
# releasing the mic anyway (ms).
VOICE_SPECULATIVE_MS=5000
# Anti-repetition-loop: max identical neighbouring words kept in a transcript
# ("अगर अगर अगर…" -> "अगर अगर"). 2 default; 1 = stricter; 0 = keep as-is.
VOICE_ASR_MAX_DUP=2
# faster-whisper only: block exact n-gram repeats during decoding (3 default;
# 0 = disable). mlx has none — relies on VOICE_ASR_MAX_DUP.
VOICE_ASR_NO_REPEAT_NGRAM=3

# ---------- Speaker-identity gate (competing-voice rejection) ----------
# Enrolls a voiceprint from VOICE_REF_AUDIO (the TTS clone clip) and drops any
# utterance that doesn't sound like the primary speaker (phone videos in the
# background, other people). Same speaker ~0.75-0.95, others ~0.4-0.6.
# Needs `uv pip install resemblyzer`; auto-disables if missing (fails open).
VOICE_SPEAKER_GATE=auto       # auto = on when resemblyzer + ref clip exist; 0 = off
# NOTE: the LIVE voice arrives through Chrome AEC/NS/AGC, so the same speaker
# scores ~0.49-0.55 vs the clean reference clip — 0.62 rejected the user on
# every utterance. 0.45 still rejects clearly different voices.
VOICE_SPEAKER_SIM_MIN=0.45    # cosine threshold; raise (0.7) for stricter, lower (0.4) if your own mic is rejected

# ---------- Server ----------
VOICE_HOST=0.0.0.0
VOICE_PORT=8000
# Comma-separated origins allowed to call this API from a browser.
# Split deploy: set to your frontend origin(s), e.g.
# VOICE_ALLOWED_ORIGINS=http://localhost:5173,https://yourdomain.com
# Default "*" = any origin (fine for LAN dev).
VOICE_ALLOWED_ORIGINS=*
# API-only GPU deploy (notmybug ships its own Molt UI): 0 = skip bundled web panel.
VOICE_SERVE_UI=0
# ---------- Filler maskers (realtime feel) ----------
# Pre-generated cloned-voice "theek hai, ruko" clips (assets/fillers/*.wav).
# Server waits VOICE_FILLER_THRESHOLD_MS, then fills only if the real reply
# isn't ready yet. 0 = disable.
VOICE_FILLER_ENABLED=1
VOICE_FILLER_THRESHOLD_MS=500
VOICE_FILLER_DIR=assets/fillers
# Server-side send: slow = wait THRESHOLD_MS, fill only if the real reply
# isn't ready yet (natural thinking pause -> filler -> breath -> answer);
# always = filler first on every chat turn; off = never send.
VOICE_FILLER_MODE=slow
# Cheap smart pick: parallel qwen call (~100ms) chooses the clip per turn
# instead of pure random. Fired alongside the main LLM turn — never serial,
# falls back to random on timeout/failure, never blocks voice. 0 = random only.
VOICE_FILLER_PICK=1
VOICE_FILLER_PICK_MODEL=qwen/qwen3.8-27b
VOICE_FILLER_PICK_TIMEOUT_S=0.3

# ---------- Screen understanding (Qwen2.5-VL vision) ----------
# VISION_BACKEND: auto (default) | api | local
#   auto  — hosted API when a key is set, else the LOCAL in-process model
#   api   — always the hosted OpenAI-compatible endpoint (needs a key)
#   local — always the in-process Qwen2.5-VL-3B (NO key needed; Kaggle path,
#           needs `pip install transformers pillow accelerate`)
# The UI's screen-share button lights up when either engine is available.
VISION_BACKEND=auto
# --- hosted engine (any OpenAI-compatible vision endpoint) ---
#   DashScope (default): https://dashscope-intl.aliyuncs.com/compatible-mode/v1
#   OpenRouter:          https://openrouter.ai/api/v1   (model: qwen/qwen-2.5-vl-72b-instruct)
#   Together:            https://api.together.xyz/v1    (model: Qwen/Qwen2.5-VL-72B-Instruct)
# Key lookup order: VISION_API_KEY -> DASHSCOPE_API_KEY (env or .env).
VISION_API_KEY=
VISION_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
VISION_MODEL=qwen2.5-vl-7b-instruct
# --- local engine (Qwen2.5-VL-3B-Instruct, runs beside the TTS on the GPU) ---
# fp16 ≈ 4.5 GB VRAM; VISION_LOCAL_4BIT=1 halves weights (~2 GB) and roughly
# DOUBLES decode speed — the single biggest local-realtime win. Recommended
# for 16 GB cards. Needs bitsandbytes (auto-installed on Linux).
VISION_LOCAL_MODEL=Qwen/Qwen2.5-VL-3B-Instruct
VISION_LOCAL_4BIT=1
# Attention kernel: sdpa (default; ~1.5x faster than eager on CUDA) | eager
VISION_LOCAL_ATTN=sdpa
# If a describe for the asked-about screen is ALREADY running when the user
# speaks, the reply waits up to this long for it (0 = never wait). This only
# ever applies to in-flight describes — none is ever started on demand.
VISION_REPLY_WAIT_S=0.3
# When the CURRENT screen's description isn't ready yet, a cached describe of
# ANY screen newer than this many seconds is used as the visual summary
# instead (the current screen's exact OCR text still ships inline in the same
# block). This is what kills the repeated "wait a minute / मैं स्क्रीन लोड कर
# रहा हूँ" dead end while screen sharing. 0 = strict per-hash caching only.
SCREEN_STALE_DESC_S=45
# 2-3 short Hindi sentences ≈ 60-80 tokens; 90 is plenty — bigger budgets
# just make every describe slower without adding usable context.
VISION_LOCAL_MAX_NEW_TOKENS=60
# Vision image downscale — 384px keeps the vision tower tiny (fast prefill
# AND decode) while OCR carries the exact-text ground truth anyway.
VISION_LOCAL_MAX_SIDE=384
# Screen-share capture cadence (ms) between client-side change-detection
# ticks, and the minimum gap between background /api/vision warm-ups.
# Served via /api/config; the UI falls back to 1200/4000 if absent. The warm
# gap also self-stretches to ~1.5x the last describe time (client-side), so
# slow describes never queue behind themselves.
SCREEN_TICK_MS=1200
SCREEN_PREFETCH_MS=4000
# ---------- Push-to-see (recommended; the new default) ----------
# Instead of continuously streaming the screen while sharing, the user HOLDS
# the screen button: the client captures immediately and every 400 ms during
# the hold, warm-up /api/vision calls describe the frame WHILE the button is
# down, and releasing (or 5 s) auto-sends the turn with the freshest frame.
# The vision describe therefore overlaps the hold instead of the reply.
# SCREEN_PUSH_MODE=0 restores the legacy always-on share loop.
SCREEN_PUSH_MODE=1
SCREEN_PUSH_MAX_MS=5000    # hold longer than this auto-sends anyway
SCREEN_PUSH_TICK_MS=400    # capture cadence during the hold
# httpx timeout for one hosted vision call (seconds)
VISION_TIMEOUT=25.0
# A description is reused (ZERO latency) while the screen hash stays the same
# for up to this long; after it the same screen is re-described once.
VISION_CACHE_TTL=600

# ---------- Downloads ----------
# Force classic HTTP instead of hf_xet chunked CDN (needed on this network)
HF_HUB_DISABLE_XET=1
